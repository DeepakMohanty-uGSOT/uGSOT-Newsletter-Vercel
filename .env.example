NODE_ENV=development

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Supabase Storage (newsletter PDFs) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=newsletters

# --- API (Express) — default 3001 (Next dev gateway uses http://localhost:3000) ---
PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=info

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_PASSWORD_HASH=

RESEND_API_KEY=
FROM_EMAIL=newsletter@example.com
# Send newsletters from any email address. Examples:
# - FROM_EMAIL=noreply@company.com
# - FROM_EMAIL=marketing@company.com
# - FROM_EMAIL=support@company.com


# --- Admin UI (Vite) — default http://localhost:5173 (embedded at http://localhost:3000 via Next gateway) ---
BASE_PATH=/

# Where Vite proxies /api (must match API PORT above)
VITE_API_TARGET=http://127.0.0.1:3001

# Optional: URL shown in Next dev gateway iframe (default http://localhost:5173)
# NEXT_PUBLIC_VITE_DEV_URL=http://localhost:5173
